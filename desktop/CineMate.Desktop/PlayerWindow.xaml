<Window x:Class="CineMate.Desktop.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="CineMate Player" Width="1180" Height="760" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">
  <Grid Background="{StaticResource VoidBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="MovieTitle" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="Локальное воспроизведение" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Закрыть" Click="Close_Click"
                AutomationProperties.Name="Закрыть плеер" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="Black">
      <vlc:VideoView x:Name="VideoView" AutomationProperties.Name="Область видео" />
      <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#F20A0B10" Padding="32">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
          <TextBlock Text="Не удалось воспроизвести видео" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,20" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource PrimaryButton}" Content="Повторить" Click="Retry_Click" Margin="0,0,8,0"
                    AutomationProperties.Name="Повторить открытие видео" />
            <Button Style="{StaticResource SecondaryButton}" Content="Закрыть" Click="Close_Click"
                    AutomationProperties.Name="Закрыть плеер после ошибки" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,14">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="CurrentTimeText" Text="0:00" Width="62" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
          <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Margin="8,0"
                  PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                  ValueChanged="SeekSlider_ValueChanged"
                  AutomationProperties.Name="Позиция воспроизведения" />
          <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Width="62" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
        </Grid>

        <WrapPanel Orientation="Horizontal">
          <Button x:Name="PlayPauseButton" Style="{StaticResource PrimaryButton}" Content="Воспроизвести" Click="PlayPause_Click" Margin="0,0,8,8"
                  AutomationProperties.Name="Воспроизвести или приостановить" />
          <Button Style="{StaticResource SecondaryButton}" Content="−10 с" Click="BackTen_Click" Margin="0,0,8,8"
                  AutomationProperties.Name="Назад на 10 секунд" />
          <Button Style="{StaticResource SecondaryButton}" Content="+10 с" Click="ForwardTen_Click" Margin="0,0,12,8"
                  AutomationProperties.Name="Вперёд на 10 секунд" />
          <Button x:Name="MuteButton" Style="{StaticResource SecondaryButton}" Content="Звук" Click="Mute_Click" Margin="0,0,8,8"
                  AutomationProperties.Name="Включить или выключить звук" />
          <Slider x:Name="VolumeSlider" Width="130" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center" Margin="0,0,8,8" ValueChanged="VolumeSlider_ValueChanged"
                  AutomationProperties.Name="Громкость" />

          <TextBlock Text="Аудио" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,8,8" />
          <ComboBox x:Name="AudioTracks" Width="170" DisplayMemberPath="Label" SelectionChanged="AudioTracks_SelectionChanged"
                    VerticalContentAlignment="Center" Margin="0,0,8,8" AutomationProperties.Name="Звуковая дорожка" />
          <TextBlock Text="Субтитры" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,8,8" />
          <ComboBox x:Name="SubtitleTracks" Width="170" DisplayMemberPath="Label" SelectionChanged="SubtitleTracks_SelectionChanged"
                    VerticalContentAlignment="Center" Margin="0,0,8,8" AutomationProperties.Name="Дорожка субтитров" />
          <Button Style="{StaticResource SecondaryButton}" Content="Во весь экран" Click="Fullscreen_Click" Margin="4,0,0,8"
                  AutomationProperties.Name="Переключить полноэкранный режим" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceRaisedBrush}" Padding="18,9">
      <TextBlock x:Name="PlaybackStatus" Text="Подготовка плеера…" Foreground="{StaticResource MutedTextBrush}"
                 AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
